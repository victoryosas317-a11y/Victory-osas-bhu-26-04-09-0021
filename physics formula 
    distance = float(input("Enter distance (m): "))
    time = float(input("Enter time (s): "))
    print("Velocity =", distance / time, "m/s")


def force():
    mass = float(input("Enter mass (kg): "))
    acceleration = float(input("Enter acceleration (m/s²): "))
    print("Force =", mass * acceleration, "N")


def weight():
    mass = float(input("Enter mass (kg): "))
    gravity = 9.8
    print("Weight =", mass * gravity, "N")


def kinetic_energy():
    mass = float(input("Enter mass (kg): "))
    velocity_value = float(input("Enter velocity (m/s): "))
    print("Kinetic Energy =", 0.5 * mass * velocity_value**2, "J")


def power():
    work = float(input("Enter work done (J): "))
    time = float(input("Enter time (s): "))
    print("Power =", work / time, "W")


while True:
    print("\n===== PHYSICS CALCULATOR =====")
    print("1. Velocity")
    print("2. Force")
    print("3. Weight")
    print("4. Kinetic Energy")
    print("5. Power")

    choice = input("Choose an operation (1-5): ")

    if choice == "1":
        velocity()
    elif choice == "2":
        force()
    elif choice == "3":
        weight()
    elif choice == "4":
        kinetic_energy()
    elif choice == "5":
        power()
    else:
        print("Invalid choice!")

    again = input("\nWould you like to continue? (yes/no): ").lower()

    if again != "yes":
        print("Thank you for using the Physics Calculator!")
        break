def velocity():
    distance = float(input("Enter distance (m): "))
    time = float(input("Enter time (s): "))
    print("Velocity =", distance / time, "m/s")


def force():
    mass = float(input("Enter mass (kg): "))
    acceleration = float(input("Enter acceleration (m/s²): "))
    print("Force =", mass * acceleration, "N")


def weight():
    mass = float(input("Enter mass (kg): "))
    gravity = 9.8
    print("Weight =", mass * gravity, "N")


def kinetic_energy():
    mass = float(input("Enter mass (kg): "))
    velocity_value = float(input("Enter velocity (m/s): "))
    print("Kinetic Energy =", 0.5 * mass * velocity_value**2, "J")


def power():
    work = float(input("Enter work done (J): "))
    time = float(input("Enter time (s): "))
    print("Power =", work / time, "W")


while True:
    print("\n===== PHYSICS CALCULATOR =====")
    print("1. Velocity")
    print("2. Force")
    print("3. Weight")
    print("4. Kinetic Energy")
    print("5. Power")

    choice = input("Choose an operation (1-5): ")

    if choice == "1":
        velocity()
    elif choice == "2":
        force()
    elif choice == "3":
        weight()
    elif choice == "4":
        kinetic_energy()
    elif choice == "5":
        power()
    else:
        print("Invalid choice!")

    again = input("\nWould you like to continue? (yes/no): ").lower()

    if again != "yes":
        print("Thank you for using the Physics Calculator!")
        break